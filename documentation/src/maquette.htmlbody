<style>
.mq { background:#0f0f12; border:1px solid #2a2a30; border-radius:10px; overflow:hidden;
      font-family:'Segoe UI',Arial,sans-serif; color:#e5e7eb; margin:14px 0 28px; }
.mq * { box-sizing:border-box; }
.mq-header { display:flex; align-items:center; gap:8px; background:#18181b; padding:10px 14px;
             border-bottom:1px solid #2a2a30; flex-wrap:wrap; }
.mq-logo { color:#C9963A; font-weight:800; font-size:18px; letter-spacing:1px; }
.mq-sep { width:1px; height:24px; background:#333; }
.mq-btn { background:#2a2a2e; color:#aaa; border-radius:6px; padding:6px 10px; font-size:11px;
          font-weight:700; }
.mq-btn.gold { background:#C9963A; color:#18181b; }
.mq-date { font-weight:700; font-size:13px; padding:0 6px; }
.mq-grow { flex:1; }
.mq-tabs { display:flex; gap:6px; background:#111113; padding:7px 14px; border-bottom:1px solid #2a2a30; }
.mq-tab { background:#1f1f24; border-radius:5px; padding:4px 12px; font-size:11px; font-weight:700; }
.mq-tab.amber { color:#F59E0B; } .mq-tab.green { color:#10B981; }
.mq-tab.red { color:#EF4444; } .mq-tab.gray { color:#6B7280; }
.mq-body { display:flex; gap:8px; padding:10px; min-height:300px; }
.mq-left { flex:1.4; } .mq-right { flex:1; background:#1a1a1f; border-radius:8px; padding:12px; }
.mq-search { background:#1e1e22; border-radius:8px; padding:8px 12px; font-size:12px; color:#666;
             margin-bottom:10px; }
.mq-slot { background:#212127; border-radius:4px; padding:5px 12px; font-size:12px; font-weight:700;
           display:flex; gap:14px; margin:10px 0 4px; }
.mq-slot .muted { color:#777788; font-weight:500; }
.mq-slot .gold { color:#C9963A; }
.mq-row { display:flex; align-items:center; background:#1e1e25; border-left:3px solid #10B981;
          padding:6px 10px; margin:3px 0; border-radius:0 4px 4px 0; }
.mq-row.amber { border-left-color:#F59E0B; }
.mq-row .ico { width:22px; font-weight:700; }
.mq-row.amber .ico { color:#F59E0B; } .mq-row .ico { color:#10B981; }
.mq-row .nm { font-weight:700; font-size:12px; }
.mq-row .ph { color:#8888AA; font-size:10px; }
.mq-row .px { margin-left:auto; color:#aaa; font-weight:700; font-size:12px; }
.mq-badge { display:inline-block; background:#F59E0B; color:#18181b; border-radius:13px;
            padding:4px 14px; font-size:11px; font-weight:700; float:right; }
.mq-h { font-size:16px; font-weight:800; }
.mq-label { color:#555566; font-size:10px; font-weight:700; text-transform:uppercase;
            margin:12px 0 4px; }
.mq-actions { display:flex; gap:6px; }
.mq-act { flex:1; text-align:center; border-radius:8px; padding:10px; font-size:12px; font-weight:700; }
.mq-act.green { background:#10B981; color:#fff; } .mq-act.red { background:#EF4444; color:#fff; }
.mq-card { background:#212127; border-radius:8px; padding:8px 12px; font-size:11px; }
.mq-card div { padding:2px 0; } .mq-card .k { color:#888899; }
.mq-quota { background:#18181b; border-top:1px solid #2a2a30; padding:8px 14px; font-size:11px;
            display:flex; align-items:center; gap:10px; }
.mq-caption { font-size:12px; color:#555; font-style:italic; margin:-18px 0 26px; }
</style>

